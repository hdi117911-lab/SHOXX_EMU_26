# =============================================================================
# ShoXx_Emu — Git Ignore Rules
# Includes: python_portable/ and sdk/ (Emulator, Platform-Tools, Platforms, Skins)
# Excludes: avd_data/*, sdk/system-images/* (AVD ROMs), and user-specific files
# =============================================================================

# 1. AVD Data & User Emulator Profiles / Containers / ADB Keys (Strictly Ignored)
avd_data/*
!avd_data/.gitkeep

# 2. AVD System Image ROM Files (Downloaded via One-Click Setup / ROM Manager)
sdk/system-images/*
!sdk/system-images/.gitkeep

# 3. User-Specific Shared Folder Contents (PC <-> Emulator Transfer Files)
Shared_PC_Folder/*
!Shared_PC_Folder/.gitkeep
!Shared_PC_Folder/SHOXX_SHARED_FOLDER_INFO.txt

# 4. Runtime Cache, Temp & Download Directories
_cache/*
!_cache/.gitkeep
downloads/*
!downloads/.gitkeep

# 5. Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# 6. User-Specific Exports, Logs, Lock Files & OS/IDE Metadata
*.log
*.lock
*.tmp
*.bak
*.orig_bak
*_Portable_Profile.zip
ShoXx_Emu_Portable_Core.zip
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
